{
  "name": "kiosk-healthcare",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Assisted Rural Healthcare KIOSK System",
  "workspaces": [
    "shared",
    "server",
    "apps/kiosk-portal",
    "apps/doctor-portal",
    "apps/patient-portal"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:doctor": "npm run dev --workspace=apps/doctor-portal",
    "dev:patient": "npm run dev --workspace=apps/patient-portal",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:doctor\" \"npm run dev:patient\"",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "postinstall": "npm run db:generate --workspace=server"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0"
  }
}
