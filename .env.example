# ===========================================
# KIOSK Healthcare - Environment Configuration
# ===========================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiosk_healthcare

# JWT Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# AI Provider (switch between "grok" and "gemini")
AI_PROVIDER=gemini
GROK_API_KEY=your-grok-api-key
GROK_MODEL=grok-3
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ElevenLabs (Speech-to-Text, Text-to-Speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Translation Provider (uses AI_PROVIDER by default, or set separately)
TRANSLATION_PROVIDER=gemini

# Medicine Stock
STOCK_LOW_THRESHOLD=10
AUTO_REORDER_ENABLED=true

# Frontend URLs (CORS)
DOCTOR_PORTAL_URL=http://localhost:5174
PATIENT_PORTAL_URL=http://localhost:5175
